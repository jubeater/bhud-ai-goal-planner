<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>jubeater.aigoalplanner</RootNamespace>
    <AssemblyName>AiGoalPlanner</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Portable PDB embedded in the DLL: VS Code's debugger only reads portable PDBs, and
         Blish HUD loads the module from memory, so embedded symbols always travel with it. -->
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      The module now has libraries Blish HUD does not ship (Microsoft.Extensions.AI.Abstractions
      and its System.Text.Json tree), so its dependencies have to travel in the .bhm. Blish HUD's
      own assemblies are filtered out again before packaging; see the target below.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- ProviderKeyStore uses ProtectedData (DPAPI), which lives in System.Security on net48. -->
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <!-- Preset data files travel in the assembly, so adding one needs no code change: every
         Presets/*.json file is read by PresetLibrary. -->
    <EmbeddedResource Include="Presets\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BlishHUD" Version="1.3.0">
      <!-- Our own content lives in ref/; Blish HUD's own content is never bundled into a module. -->
      <ExcludeAssets>contentFiles</ExcludeAssets>
      <!-- Blish HUD already loads these; the module only compiles against them. -->
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
  </ItemGroup>

  <!--
    CopyLocalLockFileAssemblies brings in Blish HUD's whole dependency tree as well as the
    libraries this module actually needs. Blish HUD already has its own assemblies loaded, so
    they are removed again before the .bhm is zipped; only what Blish HUD does not provide is
    packaged. Keep this list in step with Blish HUD's own package dependencies.
  -->
  <Target Name="TrimBlishHudAssembliesFromModule" BeforeTargets="BuildBlishHUDModule">
    <ItemGroup>
      <BlishHudProvidedFile Include="$(OutDir)Blish HUD.exe" />
      <BlishHudProvidedFile Include="$(OutDir)AsyncClipboardService.dll" />
      <BlishHudProvidedFile Include="$(OutDir)Gw2Sharp.dll" />
      <BlishHudProvidedFile Include="$(OutDir)MonoGame.Extended.dll" />
      <BlishHudProvidedFile Include="$(OutDir)MonoGame.Framework.dll" />
      <BlishHudProvidedFile Include="$(OutDir)NAudio.Core.dll" />
      <BlishHudProvidedFile Include="$(OutDir)NAudio.Wasapi.dll" />
      <BlishHudProvidedFile Include="$(OutDir)Newtonsoft.Json.dll" />
      <BlishHudProvidedFile Include="$(OutDir)SharpDX*.dll" />
      <BlishHudProvidedFile Include="$(OutDir)System.Resources.Extensions.dll" />
      <BlishHudProvidedFile Include="$(OutDir)System.ServiceModel.Primitives.dll" />
    </ItemGroup>
    <Delete Files="@(BlishHudProvidedFile)" />
    <RemoveDir Directories="$(OutDir)de;$(OutDir)es;$(OutDir)fr" />
    <!--
      Blish HUD's ZipDirectory does not create the folder it zips into, so the documented way to
      keep the module out of a locked bin\ folder (-p:BlishHUDModuleOutputDir=obj\bhm\) would fail
      with MSB3943 the first time on a fresh clone.
    -->
    <MakeDir Directories="$(BlishHUDModuleOutputDir)" />
    <!--
      The packaging target stages the whole output directory, so a .bhm left there by an earlier
      build would be packed into the next one — doubling its size, or growing it on every build
      that sends the zip elsewhere with -p:BlishHUDModuleOutputDir=... . The module file itself is
      left to the packaging target, which knows best when it can be replaced.
    -->
    <ItemGroup>
      <StaleModuleFile Include="$(OutDir)*.bhm" Exclude="$(BlishHUDModuleFilePath)" />
    </ItemGroup>
    <!-- Best effort: a Blish HUD that is running with the module loaded can still hold the file
         open, in which case this only warns and the stale zip travels along as one inert extra
         entry; failing the build instead would leave the developer with no way to build. -->
    <Delete Files="@(StaleModuleFile)" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
