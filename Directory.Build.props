<Project>

  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The maintainer builds with the .NET SDK only (no Visual Studio), and CI runs on a
      clean Windows image, so the .NET Framework 4.8 reference assemblies come from NuGet
      instead of a locally installed targeting pack.
    -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
